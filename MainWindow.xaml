<Window x:Class="BrightDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrightDisplay"
        Icon="icon.ico"
        Width="1280"
        Height="800"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="White"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#20242A"/>
            <Setter Property="BorderBrush" Value="#DDE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F3F5F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E9EDF1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="DisplaySurface" Background="White">
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="24"
                CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.12"/>
            </Border.Effect>
            <StackPanel Width="320">
                <Button x:Name="MenuToggleButton"
                        Content="Adjust display"
                        HorizontalAlignment="Right"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="MenuToggleButton_Click"/>

                <Border x:Name="AdjustmentMenu"
                        Visibility="Collapsed"
                        Margin="0,10,0,0"
                        Padding="20"
                        Background="White"
                        BorderBrush="#E3E6EA"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Display settings"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="Monitor"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#454B53"
                                   Margin="0,0,0,9"/>
                        <ComboBox x:Name="MonitorSelector"
                                  DisplayMemberPath="Label"
                                  MinHeight="38"
                                  Padding="8,4"
                                  Margin="0,0,0,18"
                                  SelectionChanged="MonitorSelector_SelectionChanged"/>

                        <TextBlock Text="Color temperature"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#454B53"
                                   Margin="0,0,0,9"/>
                        <UniformGrid Columns="3" Margin="0,0,0,18">
                            <Button Content="Warm"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource MenuButtonStyle}"
                                    Click="WarmPreset_Click"/>
                            <Button Content="Neutral"
                                    Margin="3,0"
                                    Style="{StaticResource MenuButtonStyle}"
                                    Click="NeutralPreset_Click"/>
                            <Button Content="Cool"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource MenuButtonStyle}"
                                    Click="CoolPreset_Click"/>
                        </UniformGrid>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Brightness"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#454B53"/>
                            <TextBlock x:Name="BrightnessValue"
                                       DockPanel.Dock="Right"
                                       FontSize="13"
                                       Foreground="#69717B"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="BrightnessSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="100"
                                TickFrequency="10"
                                IsSnapToTickEnabled="False"
                                ValueChanged="BrightnessSlider_ValueChanged"
                                Margin="0,0,0,16"/>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Temperature"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#454B53"/>
                            <TextBlock x:Name="TemperatureValue"
                                       DockPanel.Dock="Right"
                                       FontSize="13"
                                       Foreground="#69717B"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="TemperatureSlider"
                                Minimum="2700"
                                Maximum="6500"
                                Value="4500"
                                TickFrequency="100"
                                IsSnapToTickEnabled="False"
                                ValueChanged="TemperatureSlider_ValueChanged"
                                Margin="0,0,0,20"/>

                        <Separator Margin="0,0,0,14"/>
                        <Button Content="Exit BrightDisplay"
                                HorizontalAlignment="Stretch"
                                Background="#FFF1F0"
                                Foreground="#A12622"
                                BorderBrush="#F0CECB"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="ExitButton_Click"/>
                        <TextBlock Text="Press Esc to exit"
                                   HorizontalAlignment="Center"
                                   Foreground="#858C95"
                                   FontSize="12"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
